# Docker Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API Key (required for agents)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Database Configuration (handled by Docker Compose)
DATABASE_URL=postgresql://agentops:agentops_password@postgres:5432/agentops

# Service URLs (for internal communication)
AGENTS_API_URL=http://agents:5000
DASHBOARD_URL=http://dashboard:3000

# Optional: External access URLs (for deployment)
EXTERNAL_AGENTS_URL=http://your-domain.com:5000
EXTERNAL_DASHBOARD_URL=http://your-domain.com:3000
EXTERNAL_MCP_URL=http://your-domain.com:8000
